generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── ENUMS ───────────────────────────────────────────────────────

enum ProductStatus {
  AVAILABLE
  SOLD
  RESERVED
  NOT_SURE
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum CollectionStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
  HIDDEN // Roadmap S — A/B variant collections, direct-link only
}

enum EnquiryStatus {
  NEW
  SEEN
  REPLIED
  CLOSED
}

enum Gender {
  MALE
  FEMALE
}

// Merchandising audience segment for Category/Style/Occasion/Fabric taxonomy
// (default_product_categories, product_categories, default_product_attributes,
// product_attributes). Only LADIES is seeded today — MEN/KIDS added later
// need zero schema/code changes, just new rows.
enum ProductSegment {
  LADIES
  MEN
  KIDS
}

// Style/Occasion/Fabric share one generic taxonomy pair (DefaultProductAttribute
// + ProductAttribute) instead of three near-identical copies of the
// Category pattern (default_product_categories/product_categories). Category
// itself stays on its own dedicated model — it drives category_id (a real FK
// on Product), while Style/Occasion/Fabric are soft-matched name lists (see
// Product.styles/occasions/fabrics below).
enum ProductAttributeKind {
  STYLE
  OCCASION
  FABRIC
}

// ─── INTERNAL TEAM (Kanchuki admin/marketing/support, not retailer-side) ──

enum TeamRole {
  SUPER_ADMIN
  MARKETING_MANAGER
  MARKETING_AGENT
  SUPPORT_MANAGER
  SUPPORT_AGENT
}

enum TerritoryLevel {
  STATE
  CITY
  ZONE
}

enum TicketStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

// F-019: distinguishes the paid on-site catalog upload service from
// ordinary support tickets, which stay ticket_type = GENERAL
enum TicketType {
  GENERAL
  CATALOG_UPLOAD
}

// ─── PLAN FEATURE MATRIX (F-013) ─────────────────────────────────

enum PlanFeatureKey {
  BULK_ONBOARDING_IMPORT
  CUSTOM_BACKGROUND_LIBRARY
  // @deprecated - removed in migration 082
  SPIN_360
  // @deprecated - removed in migration 082
  VIRTUAL_TRY_ON
  WHATSAPP_BUSINESS_API
  WHATSAPP_CATALOG_SYNC
  // @deprecated - removed in migration 082
  CHECKOUT_CART
  DATA_EXPORT_CSV
  CUSTOM_BRANDING
  GHOST_MANNEQUIN_AI
  // @deprecated - removed in migration 082
  RAZORPAY_ROUTE
  API_ACCESS
  PRIORITY_AI_QUEUE
  MULTI_STORE
  GROWTH_ENGINE
  // @deprecated - removed in migration 082
  PARTNER_NETWORK
  // @deprecated - removed in migration 082
  INCENTIVE_ENGINE
  // @deprecated - removed in migration 082
  FESTIVAL_BACKGROUNDS
  // @deprecated - removed in migration 082
  LOOKBOOK_GENERATOR
  SOCIAL_TEMPLATES
  CHANNEL_SYNC
}

// ─── QUOTA & LIMITS (F-010) ──────────────────────────────────────

enum QuotaResourceType {
  PRODUCT_UPLOAD
  AI_TAGGING_CALL
  // @deprecated - removed in migration 082
  TRY_ON
  IMAGE_CROP
  BG_REMOVAL
  API_REQUEST
  STUDIO_SHOOT
}

enum QuotaPeriod {
  DAY
  MONTH
  LIFETIME
}

enum QuotaAddonStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── RETAILERS ───────────────────────────────────────────────────

model Retailer {
  id           String  @id @default(cuid())
  auth_user_id String  @unique // Supabase auth.users.id
  phone        String  @unique
  shop_name    String
  owner_name   String?
  city         String
  state        String?
  gstin        String?

  // WhatsApp business number — nullable, falls back to `phone` if unset
  // Allows retailers to use a separate business number for collection link
  // enquiries and remote try-on (PRO-REQUIREMENTS.md F-009 §4).
  whatsapp_number String?

  // Full address (city/state above are pre-existing, kept for search/display)
  // address_line1 is enforced as required at the API/UI layer (F-009 profile
  // edit) — kept nullable in the DB since older rows predate the requirement.
  address_line1 String?
  address_line2 String?
  pincode       String?

  // Store branding — optional
  logo_url    String?
  logo_r2_key String?
  banner_url    String?
  banner_r2_key String?

  // KYC verification (F-009) — GST certificate + Aadhar front/back for identity proof
  kyc_status              KycStatus @default(NOT_SUBMITTED)
  kyc_gst_url             String?
  kyc_gst_r2_key          String?
  kyc_aadhar_front_url    String?
  kyc_aadhar_front_r2_key String?
  kyc_aadhar_back_url     String?
  kyc_aadhar_back_r2_key  String?
  kyc_submitted_at        DateTime?
  kyc_reviewed_at         DateTime?
  kyc_rejection_reason    String?

  // Customer referral program config (roadmap C).

// Meta WhatsApp Business API — retailer's own credentials, bring-your-own.
   // When set, collection bulk-send uses this instead of the one-by-one wa.me
   // flow. Requires a pre-approved message template in the retailer's Meta
   // Business Manager (single body variable — see collections.ts bulk-send).
   whatsapp_api_phone_number_id String?
   whatsapp_api_access_token    String?
   whatsapp_api_template_name   String?
   whatsapp_api_template_lang   String?
   whatsapp_api_configured_at   DateTime?

   // Google My Business
   gmb_account_id   String? // Google My Business account ID
   gmb_location_id  String? // Google My Business location ID (for the retailer's shop)
   gmb_access_token String? // Encrypted access token for GMB API
   gmb_refresh_token String? // Encrypted refresh token
   gmb_token_expiry DateTime? // Expiry time of the access token

   // F-021 Ratings — Google Business Profile place ID for review deep-link
   google_place_id String? // retailer pastes once; Kanchuki builds the write-review URL

   // F-021 Ratings — denormalized store rating (updated on every review write)
   avg_rating    Float @default(0)
   rating_count  Int   @default(0)
   gmb_configured_at DateTime? // When GMB was last configured

   // Facebook Local Awareness Ads (bring-your-own Meta Business creds)
   fb_ads_access_token  String? // Encrypted long-lived Business token
   fb_ads_ad_account_id String? // Facebook Ad Account ID (act_XXXX)
   fb_ads_page_id       String? // Facebook Page ID for ad creative
   fb_ads_configured_at DateTime?

   // Google Local Service Ads (bring-your-own Google Ads creds)
   google_ads_refresh_token String? // Encrypted OAuth refresh token
   google_ads_customer_id   String? // Google Ads customer ID (XXX-XXX-XXXX)
   google_ads_configured_at DateTime?
   google_ads_developer_token String? // Encrypted developer token

   // WhatsApp Native Catalog Sync (Phase II) — sync product catalog to
   // WhatsApp Business native catalog (in-app product list under business profile).
   whatsapp_catalog_id    String? // Meta catalog ID (from WABA)
   sync_enabled           Boolean  @default(false)
   sync_categories        String[] @default([]) // ProductCategory IDs to sync
   last_synced_at         DateTime?

  categories String[] // ["suits", "sarees", "kurtis"]

  // Public QR profile — visitors scan a QR encoding /store/{public_slug},
  // pass the contact gate, then land on this collection as the storefront.
  public_slug              String? @unique
  storefront_collection_id String? // FK to Collection.id, no Prisma relation (loose pointer, same convention as Product.source_id)

  // Internal team attribution (Section 10, PRO-REQUIREMENTS.md) — nullable,
  // only set for retailers onboarded/derived through the internal team flow.
  territory_id     String?
  onboarded_by_id  String? // TeamMember.id — marketing agent who signed them up
  support_owner_id String? // TeamMember.id — current support point of contact

  // Subscription
  plan            SubscriptionPlan   @default(STARTER)
  plan_status     SubscriptionStatus @default(TRIAL)
  trial_ends_at   DateTime?
  plan_expires_at DateTime?

  // Usage limits (snapshot from plan, avoids join on every request)
  max_products    Int @default(500)
  max_customers   Int @default(999999)
  max_staff_seats Int @default(3) // 3 free, additional seats ₹199/mo (PRO-REQUIREMENTS.md §6)

  // Razorpay
  razorpay_customer_id     String?
  razorpay_subscription_id String?

  // Onboarding
  onboarding_completed Boolean @default(false)
  onboarding_step      Int     @default(0)

  // Roadmap M — Multi-Language AI: preferred locale for the retailer app UI.
  // Defaults to 'en-IN' (English). Content language (AI descriptions) is
  // driven by the customer's locale, not the retailer's UI locale.
  preferred_locale String? @default("en-IN")

  // Suspension (F-015) — reversible, distinct from deleted_at (soft-delete)
  is_suspended     Boolean  @default(false)
  suspended_at     DateTime?
  suspended_reason String?
  suspended_by_id  String?  // TeamMember.id

  // Store-directory curation — admin pins stores so they sort to the top of
  // the public directory (/stores) and the homepage teaser. Admin-only flag,
  // no retailer-facing surface. featured_at records when it was pinned (used
  // as a secondary sort key among pinned stores).
  is_featured Boolean   @default(false)
  featured_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  products              Product[]
  customers             Customer[]
  collections           Collection[]
  staff                 Staff[]
  store_sections        StoreSection[]
  product_categories    ProductCategory[]
  product_attributes    ProductAttribute[]
  subscriptions         Subscription[]
  limit_overrides       RetailerLimitOverride[]
  usage_counters        UsageCounter[]
  quota_addon_purchases QuotaAddonPurchase[]
  ai_usage_logs         AiUsageLog[]
  catalog_items         CatalogItem[]
  catalog_sync_logs     CatalogSyncLog[]
  territory             Territory?              @relation(fields: [territory_id], references: [id])
  onboarded_by          TeamMember?             @relation("OnboardedRetailers", fields: [onboarded_by_id], references: [id])
  support_owner         TeamMember?             @relation("SupportedRetailers", fields: [support_owner_id], references: [id])
  suspended_by          TeamMember?             @relation("SuspendedRetailers", fields: [suspended_by_id], references: [id])
  support_tickets       SupportTicket[]
  social_accounts       SocialAccount[]
  social_posts          SocialPost[]
  store_visits          CustomerStoreVisit[]
  social_templates      SocialTemplate[]
  channel_syncs         ChannelSync[]
  product_reviews       ProductReview[]
  store_reviews         StoreReview[]
  bug_reports         BugReport[]

  @@index([phone])
  @@index([city])
  @@index([territory_id])
@@index([is_suspended])
   @@index([is_featured])
// Location for geo-targeting and GMB
   latitude   Float?
   longitude  Float?
   @@index([latitude, longitude])
   @@map("retailers")
}
  

// ─── SMART INCENTIVE ENGINE ────────────────────────────────────────

// ─── STORE STRUCTURE ─────────────────────────────────────────────
model StoreSection {
  id          String  @id @default(cuid())
  retailer_id String
  name        String
  type        String  @default("rack") // rack | shelf | section | floor | box
  parent_id   String?
  sort_order  Int     @default(0)

  retailer Retailer       @relation(fields: [retailer_id], references: [id])
  parent   StoreSection?  @relation("SectionTree", fields: [parent_id], references: [id])
  children StoreSection[] @relation("SectionTree")
  products Product[]

  @@index([retailer_id])
  @@map("store_sections")
}

// ─── PRODUCT CATEGORIES ──────────────────────────────────────────
// Retailer-curated merchandising group with a cover photo — distinct from
// Product.category (free-text AI tag like "Saree", "Kurti"). Drives the
// customer-facing "browse by category" screen after storefront signup.

model ProductCategory {
  id           String         @id @default(cuid())
  retailer_id  String
  name         String
  segment      ProductSegment @default(LADIES)
  image_url    String?
  image_r2_key String?
  sort_order   Int            @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  retailer Retailer  @relation(fields: [retailer_id], references: [id])
  products Product[]

  @@unique([retailer_id, name])
  @@index([retailer_id])
  @@map("product_categories")
}

// ─── F-024: admin-editable GLOBAL template for retailer category defaults ─
// Copied into every new retailer's ProductCategory rows at onboarding (and
// backfilled once for existing retailers via migration 045). AI tagging
// (tag-product.ts) matches its free-text category result against the
// retailer's own ProductCategory list and sets category_id — so the
// storefront "Shop By Categories" grid fills itself without the retailer
// picking categories by hand. Admin edits here are forward-only (new
// signups only), same precedent as plan_limits/PlanFeature.
model DefaultProductCategory {
  id         String         @id @default(cuid())
  name       String         @unique
  segment    ProductSegment @default(LADIES)
  sort_order Int            @default(0)
  is_active  Boolean        @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("default_product_categories")
}

// ─── STYLE / OCCASION / FABRIC — generic taxonomy (mirrors the Category
// pattern above, generalized across the three kinds instead of three
// near-duplicate model pairs). Product.styles/occasions/fabrics store the
// plain attribute names (no FK) — same soft-match convention Product.occasions
// already used pre-existing. AI tagging (tag-product.ts) writes its raw
// per-photo guesses directly into these arrays; the retailer's own
// ProductAttribute rows (defaults + custom) are what the product-add screen
// offers as selectable options, matched case-insensitively.
model DefaultProductAttribute {
  id         String               @id @default(cuid())
  kind       ProductAttributeKind
  segment    ProductSegment       @default(LADIES)
  name       String
  sort_order Int                  @default(0)
  is_active  Boolean              @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([kind, segment, name])
  @@map("default_product_attributes")
}

model ProductAttribute {
  id          String               @id @default(cuid())
  retailer_id String
  kind        ProductAttributeKind
  segment     ProductSegment       @default(LADIES)
  name        String
  sort_order  Int                  @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  retailer Retailer @relation(fields: [retailer_id], references: [id])

  @@unique([retailer_id, kind, name])
  @@index([retailer_id, kind])
  @@map("product_attributes")
}

// ─── PRODUCTS ────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  retailer_id String
  name        String?
  sku         String?
  description String?
  price_min   Int? // stored as paise (₹1500 = 150000)
  price_max   Int?
  mrp         Int?
  status      ProductStatus @default(AVAILABLE)

  // AI-generated (editable)
  category         String?
  subtype          String? // finer-grained garment type, e.g. "Lehenga Skirt", "Kurta Set", "Suit with Dupatta"
  product_type     String?
  primary_color    String?
  secondary_colors String[]
  fabric_estimate  String?
  pattern          String?
  embellishments   String[]
  neck_style       String?
  sleeve_type      String?
  occasions        String[]
  styles           String[] // e.g. "Anarkali Suits", "Indo Western" — matched against retailer's ProductAttribute(kind: STYLE) list, no FK (same convention as occasions)
  fabrics          String[] // e.g. "Cotton", "Georgette" — matched against ProductAttribute(kind: FABRIC); fabric_estimate above stays the free-text AI description
  search_tags      String[]

  // Retailer-selected sizes available for this item (S, M, L, XL, XXL, XXXL)
  sizes String[] @default([])

  // Indian fit flags (roadmap N) — blouse-piece / unstitched markers that
  // matter for sarees and unstitched suit sets, shown on the product page.
  is_unstitched Boolean @default(false)
  includes_blouse Boolean @default(false)

  // Flexible extra metadata
  metadata Json?
  notes    String?

  // Physical location
  section_id     String?
  location_notes String?

  // Tagging state
  ai_tagged    Boolean @default(false)
  ai_tag_error String?

  // 360-degree spin view state — null until a spin video is uploaded.
  // 'processing' | 'ready' | 'failed', set by the frame-extraction job.

  // F-011: retailer-picked backdrop from the admin-curated library, applied
  // by cleanupProductPhoto() in place of the default white flatten. Null =
  // white (unchanged default behavior).
  background_image_id String?

  // Retailer toggle: composite a soft drop shadow under the cutout garment
  // during background removal (cleanupProductPhoto). Read by the auto-clean
  // job at upload time; per-photo /cleanup calls can override it ad hoc
  // without persisting, same pattern as background_image_id.
  add_shadow Boolean @default(false)

  // Retailer-curated merchandising group (see ProductCategory) — distinct
  // from the free-text `category` AI tag above.
  category_id String?

  // WhatsApp Native Catalog Sync — stores Meta's catalog item ID
  whatsapp_catalog_item_id String?

  // F-021 Ratings — denormalized product rating (updated on every review write)
  avg_rating   Float @default(0)
  rating_count Int   @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  retailer         Retailer              @relation(fields: [retailer_id], references: [id])
  section          StoreSection?         @relation(fields: [section_id], references: [id])
  background_image BackgroundImage?      @relation(fields: [background_image_id], references: [id], onDelete: SetNull)
  product_category ProductCategory?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  photos           ProductPhoto[]
  videos           ProductVideo[]
  reviews          ProductReview[]
  variants         ProductVariant[]
  embedding        ProductEmbedding?
  collection_items CollectionProduct[]
  recently_viewed  CustomerRecentlyViewed[]
  wishlist_items   CustomerWishlistItem[]
  catalog_item     CatalogItem?

  @@unique([retailer_id, sku])
  @@index([retailer_id])
  @@index([retailer_id, status])
  @@index([retailer_id, category])
  @@index([retailer_id, subtype])
  @@index([retailer_id, category_id])
  @@index([retailer_id, deleted_at])
  @@map("products")
}

model ProductPhoto {
  id          String @id @default(cuid())
  product_id  String
  retailer_id String

  url        String
  r2_key     String
  is_primary Boolean @default(false)
  width      Int?
  height     Int?
  size_bytes Int?

  ai_tagged       Boolean @default(false)
  ai_raw_response Json?

  // Retailer-tagged piece role for multi-piece outfits (kameez+salwar, kurta+
  // pajama, choli+skirt) — 'upper' | 'lower' | null. Drives try-on chaining
  // in packages/ai/src/tryon.ts; see PRO-REQUIREMENTS.md F-102.
  piece_type String?

  // F-001d bulk onboarding: 64-bit aHash hex string, used to flag likely
  // duplicate re-shoots of the same garment across rack photos/imports.
  // See packages/ai/src/phash.ts.
  phash String?

  // F-001e: ghost-mannequin generation provenance and other photo-level
  // metadata. JSON for flexible expansion — stores provider name,
  // generated_at, error messages, original photo URL on failure, etc.
  metadata Json?

  sort_order Int      @default(0)
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_photos")
}

model ProductVariant {
  id          String @id @default(cuid())
  product_id  String
  retailer_id String

  color          String
  photo_url      String?
  r2_key         String? // R2 storage key, used for generating presigned GET URLs
  ai_preview_url String?
  is_ai_preview  Boolean       @default(false)
  status         ProductStatus @default(AVAILABLE)
  price_override Int?

  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_variants")
}

model ProductEmbedding {
  id          String @id @default(cuid())
  product_id  String @unique
  retailer_id String

  // pgvector — 1536-dim for OpenAI text-embedding-3-small
  embedding Unsupported("vector(1536)")?

  input_hash    String // SHA-256 of product text fields
  model_version String @default("text-embedding-3-small")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([retailer_id])
  @@map("product_embeddings")
}

// ─── CUSTOMERS ───────────────────────────────────────────────────

model Customer {
  id          String @id @default(cuid())
  retailer_id String

  name       String
  phone      String
  phone_hash String?
  email      String?
  gender     Gender?

  // Consent to be contacted — required when captured via the public QR
  // profile gate, unset for retailer-manual-entry customers.
  consent_given Boolean   @default(false)
  consent_at    DateTime?

  // Lead origin — how this customer first reached the retailer (roadmap B:
  // QR lead capture source tracking). QR_SCAN = storefront QR contact gate.
  source CustomerLeadSource @default(MANUAL)

  // Full address
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  pincode       String?

  // Explicit preferences (retailer-entered)
  pref_colors    String[]
  pref_styles    String[]
  pref_fabrics   String[]
  pref_occasions String[]
  budget_min     Int? // paise
  budget_max     Int? // paise

  // Roadmap N — "What's your usual size?" quick capture (S, M, XL, 4XL …).
  // Drives per-customer size recommendation on products they browse.
  usual_size String?

  notes String?

  last_visit_at   DateTime?
  total_purchases Int       @default(0)
  total_spent     Int       @default(0) // paise

  // Blocked status (F-015) — customers have no login (Section 2.2 PRO-REQUIREMENTS),
  // so "block" means blocking new enquiries/checkout, not an account lock.
  is_blocked     Boolean  @default(false)
  blocked_at     DateTime?
  blocked_reason String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Shopper Passport — link to global identity (set during backfill Task 6
  // and on new passport-verified leads Task 5). Nullable until backfill runs.
  customer_account_id String?

  retailer         Retailer              @relation(fields: [retailer_id], references: [id])
  customer_account CustomerAccount?      @relation(fields: [customer_account_id], references: [id])
  collections_sent Collection[]          @relation("CustomerCollections")
  product_reviews  ProductReview[]
  store_reviews    StoreReview[]

  @@unique([retailer_id, phone])
  @@index([retailer_id])
  @@index([retailer_id, phone_hash])
  @@index([customer_account_id])
  @@map("customers")
}

// ─── CUSTOMER MEASUREMENTS (Phase 1 — VTO fit input) ────────────

// ─── COLLECTIONS ─────────────────────────────────────────────────

model Collection {
  id          String  @id @default(cuid())
  retailer_id String
  customer_id String?

  title       String
  description String?
  slug        String           @unique
  status      CollectionStatus @default(ACTIVE)
  expires_at  DateTime?

  // Cached analytics
  view_count          Int @default(0)
  unique_viewer_count Int @default(0)
  enquiry_count       Int @default(0)
  favorite_count      Int @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  retailer  Retailer            @relation(fields: [retailer_id], references: [id])
  customer  Customer?           @relation("CustomerCollections", fields: [customer_id], references: [id])
  products  CollectionProduct[]
  views     CollectionView[]
  enquiries CollectionEnquiry[]

  @@index([retailer_id])
  @@index([slug])
  @@index([retailer_id, status])
  @@map("collections")
}

model CollectionProduct {
  id            String @id @default(cuid())
  collection_id String
  product_id    String
  sort_order    Int    @default(0)

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [product_id], references: [id])

  @@unique([collection_id, product_id])
  @@index([collection_id])
  @@map("collection_products")
}

model CollectionView {
  id            String @id @default(cuid())
  collection_id String
  retailer_id   String

  viewer_token String?
  ip_hash      String?
  user_agent   String?

  created_at DateTime @default(now())

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)

  @@index([collection_id])
