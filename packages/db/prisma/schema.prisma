// ─── ADMIN COMMISSION LEDGER (3% of monthly revenue) ────────────
// Admin-only expense ledger charged against the 3% commission set aside
// from each month's total successful subscription payments. The monthly
// commission itself is computed on the fly from subscription_payments
// (status='success', grouped by paid_at month) — only expense entries are
// stored here. `period` is the YYYY-MM month the expense is charged against;
// `category` is the free-text "where did the money go" (Marketing, Travel,
// Software, Staff, ...). No retailer-facing surface — admin panel only.
model AdminCommissionExpense {
  id          String   @id @default(cuid())
  period      String // YYYY-MM commission month this expense is charged against
  amount_inr  Int // paise
  category    String // where the money was spent
  expense_date DateTime // date of the expense
  notes       String?

  // Soft delete (SECURITY §19: the app role kanchuki_app is DELETE-less, so
  // admin "delete" sets deleted_at and every read filters it out — same
  // deleted_at pattern as products). The purge cron can hard-delete later.
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([period])
  @@index([expense_date])
  @@index([deleted_at])
  @@map("admin_commission_expenses")
}

