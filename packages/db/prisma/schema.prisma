  @@map("product_videos")
}

// ─── WHATSAPP NATIVE CATALOG SYNC (Phase II) ──────────────────────
// Sync Kanchuki product catalog to WhatsApp Business native catalog.

enum CatalogSyncStatus {
  SUCCESS
  FAILED
  PARTIAL
  IN_PROGRESS
}

model CatalogItem {
  id                      String   @id @default(cuid())
  retailer_id             String
  product_id              String   @unique // One product = one catalog item
  whatsapp_catalog_item_id String  // Meta's catalog item ID
  whatsapp_catalog_id     String   // Meta's catalog ID (cached)

  // Sync state
  status                  CatalogSyncStatus @default(IN_PROGRESS)
  last_synced_at          DateTime?
  error_message           String?

  // Retailer's product data snapshot at sync time
  product_name_snapshot   String
  product_price_paise     Int
  product_status_snapshot String // AVAILABLE/SOLD/RESERVED
  hsn_code_snapshot       String?

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  retailer Retailer @relation(fields: [retailer_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([retailer_id])
  @@index([whatsapp_catalog_id])
  @@map("catalog_items")
}

model CatalogSyncLog {
  id              String   @id @default(cuid())
  retailer_id     String
  catalog_item_id String?

  // Operation type
  operation       String   // 'full_sync' | 'single_product' | 'webhook'
  product_id      String?

  // Meta API details
  meta_item_id    String?
  meta_catalog_id String?

  // Result
  status          CatalogSyncStatus
  error_message   String?
  payload_json    Json?    // Request/response payload for debugging

  created_at      DateTime @default(now())

  retailer Retailer @relation(fields: [retailer_id], references: [id], onDelete: Cascade)

  @@index([retailer_id, created_at])
  @@index([catalog_item_id])
  @@map("catalog_sync_logs")
}

// ─── LOOKBOOK GENERATOR ──────────────────────────────────────────
// Retailer-curated product lookbooks: pick 3-10 products → AI generates
// styled lookbook with layout, captions, and export to Instagram/WA/PDF.

// ─── AI SOCIAL MEDIA TEMPLATES ───────────────────────────────────
// Admin-managed template presets for social media image generation.
// Retailers generate social posts from product photos using these templates.
model SocialTemplate {
  id          String   @id @default(cuid())
  retailer_id String
  retailer    Retailer @relation(fields: [retailer_id], references: [id])

  name        String   // e.g. "Diwali Instagram Post"
  description String?
  template_type SocialTemplateType @default(INSTAGRAM_POST)

  // Template configuration
  occasion    String?  // e.g. "Diwali", "Wedding", "Eid"
  platform    String?  // e.g. "instagram", "whatsapp", "facebook"
  overlay_festival String? // Festival overlay style
  background_style String? // e.g. "gold_festive", "white_studio", "wedding_elegant"

  // Generation metadata
  image_url   String?  // Generated template image URL
  image_r2_key String?
  caption     String?  // AI-generated caption text
  hashtags    String[] // Generated hashtags

  // Usage stats
  usage_count Int      @default(0)
  product_ids String[] // Products used with this template

  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([retailer_id])
  @@index([template_type])
  @@index([occasion])
  @@map("social_templates")
}

enum SocialTemplateType {
  INSTAGRAM_POST
  INSTAGRAM_REEL
  INSTAGRAM_STORY
  WHATSAPP_STATUS
  WHATSAPP_CATALOG
  FACEBOOK_POST
  FACEBOOK_STORY
  PDF_FLYER
}

// ─── AGGREGATOR / MARKETPLACE SYNC ───────────────────────────────
// Track retailer connections to external marketplaces (Meesho, Instamojo, etc.)
// and sync status for product listings, inventory, and orders.
model ChannelSync {
  id          String   @id @default(cuid())
  retailer_id String
  retailer    Retailer @relation(fields: [retailer_id], references: [id])

  channel     ChannelType
  status      ChannelSyncStatus @default(DISCONNECTED)

  // API credentials (encrypted at app layer)
  api_key_encrypted   String?
  api_secret_encrypted String?
  auth_token_encrypted String?
  webhook_secret       String?

  // Sync metadata
  last_synced_at  DateTime?
  last_sync_error String?
  products_synced Int      @default(0)
  orders_synced   Int      @default(0)

  // Channel-specific config
  channel_shop_id  String?  // External marketplace shop/seller ID
  channel_shop_url String?  // Public shop URL on marketplace

  is_active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([retailer_id, channel])
  @@index([retailer_id])
  @@index([channel])
  @@index([status])
  @@map("channel_syncs")
}

enum ChannelType {
  MEESHO
  INSTAMOJO
  GLOAD
  CRAFTSVILLA
  FLIPKART
  AMAZON
  OTHER
}

enum ChannelSyncStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  SYNCING
  ERROR
  SUSPENDED
}

// ─── F-021 RATINGS & REVIEWS ──────────────────────────────────────

model ProductReview {
  id          String @id @default(cuid())
  product_id  String
  customer_id String
  retailer_id String // denormalized for retailer-facing queries + moderation
  rating      Int    // 1–5 stars
  comment     String?
  is_flagged  Boolean @default(false) // admin moderation flag
  is_hidden   Boolean @default(false) // soft-hidden by admin (still in DB, not shown)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  product  Product  @relation(fields: [product_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  retailer Retailer @relation(fields: [retailer_id], references: [id])

  @@unique([product_id, customer_id]) // one review per customer per product
  @@index([product_id])
  @@index([retailer_id])
  @@index([customer_id])
  @@index([rating])
  @@map("product_reviews")
}

model StoreReview {
  id          String @id @default(cuid())
  retailer_id String
  customer_id String
  rating      Int    // 1–5 stars
  comment     String?
  is_flagged  Boolean @default(false) // admin moderation flag
  is_hidden   Boolean @default(false) // soft-hidden by admin
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id])
  retailer Retailer @relation(fields: [retailer_id], references: [id])

  @@unique([retailer_id, customer_id]) // one store review per customer per retailer
  @@index([retailer_id])
  @@index([customer_id])
  @@index([rating])
  @@map("store_reviews")
}

// ─── UNSTITCHED DESIGN GALLERY ──────────────────────────────────
// Admin-curated reference designs for unstitched suits.
// Customers browse by category (neckline, sleeve, etc.) and share
// design images to their tailor via WhatsApp.
enum DesignCategory {
  NECKLINE
  BLOUSE_BACK
  SLEEVE
  SALWAR
  SILHOUETTE
}

model DesignReference {
  id          String  @id @default(cuid())
  category    DesignCategory
  option      String  // e.g. "V-shape", "bell", "anarkali"
  name        String  // display name, e.g. "Boat Neck"
  image_url   String  // R2 URL
  r2_key      String  // R2 object key for deletion
  description String?
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([category])
  @@index([category, is_active])
  @@map("design_references")
}

// ─── RETAILER BUG REPORTS ────────────────────────────────────────
// Retailer-submitted bug reports / feature requests from the mobile app.
// Auto-captures device info + screen context. Visible to admin only.

enum BugReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugReportStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model BugReport {
  id          String            @id @default(cuid())
  retailer_id String
  description String
  severity    BugReportSeverity @default(MEDIUM)
  status      BugReportStatus   @default(NEW)

  // Auto-captured device context
  app_version     String?  // e.g. "1.0.0"
  os_version      String?  // e.g. "Android 14"
  device_model    String?  // e.g. "Samsung Galaxy A14"
  screen_name     String?  // which screen the user was on
  last_screen     String?  // previous screen (navigation trail)
  error_message   String?  // if triggered from an ErrorBoundary, the JS error
  error_stack     String?  // component stack from ErrorBoundary

  // Optional screenshot (R2 URL)
  screenshot_url  String?
  screenshot_r2_key String?

  // Retailer's own words about the issue
  notes           String?

  // Admin response
  admin_note      String?
  resolved_by_id  String? // TeamMember.id

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  resolved_at     DateTime?

  retailer        Retailer  @relation(fields: [retailer_id], references: [id])

  @@index([retailer_id])
  @@index([status])
  @@index([severity])
  @@index([created_at])
  @@map("bug_reports")
}

// ─── SHOPPER PASSPORT (Task 1 — customer-qr-identity-solution.md §7) ──
// Global customer identity above per-retailer Customer rows.
// Cookie-based session (Task 3), not Supabase Auth.
model CustomerAccount {
  id          String   @id @default(cuid())
  phone       String   @unique // E.164 +9198...
  phone_hash  String   @unique // SHA-256 of normalizeIndianPhone — matches Customer.phone_hash
  name        String?
  gender      Gender?
  city        String?
  state       String?
  usual_size  String? // feeds cross-store size reco (roadmap N)
  is_verified Boolean  @default(true) // set true only after OTP

  // Explicit preferences (set by shopper in /my-profile)
  pref_colors    String[]
  pref_styles    String[]
  pref_fabrics   String[]
  pref_occasions String[]
  budget_min     Int? // paise
  budget_max     Int? // paise
  notes          String?

  // Personalization toggle — when false, behavioral writes (view/favorite/
  // search) are suppressed and the preference vector is frozen/cleared.
  profiling_enabled Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  store_visits        CustomerStoreVisit[]
  customer_links      Customer[]
  consent_events      ConsentEvent[]
  recently_viewed     CustomerRecentlyViewed[]
  wishlist_items      CustomerWishlistItem[]
  passport_sessions   PassportSession[]

  @@map("customer_accounts")
}

// One row per (shopper, retailer). Tracks scan + per-store consent state.
model CustomerStoreVisit {
  id                  String   @id @default(cuid())
  customer_account_id String
  retailer_id         String
  source              CustomerLeadSource @default(QR_SCAN)
  first_visited_at    DateTime @default(now())
  last_visited_at     DateTime @default(now())
  visit_count         Int      @default(1)
  contact_shared      Boolean  @default(false) // has the raw number been written to this retailer's Customer row
  whatsapp_consent    Boolean  @default(false) // DPDP: NOT default true
  whatsapp_consent_at DateTime?
  is_muted            Boolean  @default(false) // checked at WhatsApp send time

  customer_account CustomerAccount @relation(fields: [customer_account_id], references: [id], onDelete: Cascade)
  retailer         Retailer        @relation(fields: [retailer_id], references: [id], onDelete: Cascade)

  @@unique([customer_account_id, retailer_id])
  @@index([retailer_id, last_visited_at])
  @@map("customer_store_visits")
}

// Append-only consent/withdrawal audit (DPDP record-keeping)
model ConsentEvent {
  id                  String   @id @default(cuid())
  customer_account_id String
  retailer_id         String?
  kind                String   // PASSPORT_CREATED | STORE_CONSENT_GRANTED | STORE_MUTED | STORE_CONSENT_WITHDRAWN | PASSPORT_DELETED | PROFILING_ENABLED | PROFILING_DISABLED | DATA_EXPORTED
  notice_version      String   // which notice text was shown
  ip_hash             String?
  user_agent          String?
  created_at          DateTime @default(now())

  customer_account CustomerAccount @relation(fields: [customer_account_id], references: [id], onDelete: Cascade)

  @@index([customer_account_id, created_at])
  @@map("consent_events")
}

// Passport session (DB row + Redis cache, Task 3)
model PassportSession {
  id                  String   @id @default(cuid())
  customer_account_id String
  created_at          DateTime @default(now())
  last_seen_at        DateTime @default(now())
  expires_at          DateTime
  revoked_at          DateTime?
  user_agent          String?
  ip_hash             String?

  customer_account CustomerAccount @relation(fields: [customer_account_id], references: [id], onDelete: Cascade)

  @@index([customer_account_id])
  @@map("passport_sessions")
}

// Identity-scoped recently-viewed (replaces localStorage same-store tracker)
model CustomerRecentlyViewed {
  id                  String   @id @default(cuid())
  customer_account_id String
  product_id          String
  retailer_id         String
  viewed_at           DateTime @default(now())

  customer_account CustomerAccount @relation(fields: [customer_account_id], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([customer_account_id, product_id])
  @@index([customer_account_id, viewed_at])
  @@map("customer_recently_viewed")
}

// Identity-scoped cross-store favorites (delivers deferred item 22)
model CustomerWishlistItem {
  id                  String   @id @default(cuid())
  customer_account_id String
  product_id          String
  retailer_id         String
  created_at          DateTime @default(now())

  customer_account CustomerAccount @relation(fields: [customer_account_id], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([customer_account_id, product_id])
  @@index([customer_account_id])
  @@map("customer_wishlist_items")
}

// Nightly precomputed store-discovery score per shopper (§16.4)
