{
  "name": "@kanchuki/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:generate:vault": "prisma generate --schema=prisma/vault-schema.prisma",
    "postinstall": "prisma generate && node -e \"process.env.VAULT_DATABASE_URL ? require('child_process').execSync('prisma generate --schema=prisma/vault-schema.prisma', { stdio: 'inherit' }) : console.log('[vault] VAULT_DATABASE_URL not set — skipping vault client generation')\"",
    "db:seed": "prisma db seed",
    "db:seed:plan-limits": "tsx prisma/seed-plan-limits.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "prisma": "^5.16.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
