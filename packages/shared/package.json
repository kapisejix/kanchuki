{
  "name": "@kanchuki/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/strip-comments.ts",
      "import": "./dist/testing/strip-comments.js",
      "default": "./dist/testing/strip-comments.js"
    },
    "./testing/doc-table-guard": {
      "types": "./src/testing/doc-table-guard.ts",
      "import": "./dist/testing/doc-table-guard.js",
      "default": "./dist/testing/doc-table-guard.js"
    },
    "./constants/app-identity": {
      "types": "./src/constants/app-identity.ts",
      "default": "./src/constants/app-identity.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
