# ─── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Transaction pooler for runtime (Fastify API)
DATABASE_URL_POOLER="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# SECURITY §13: Read-replica / warm standby for admin queries and analytics.
# Used by the admin query runner — NEVER for runtime writes.
DATABASE_URL_REPLICA=""
# SECURITY §13: Cold backup / disaster recovery database — independent from
# Supabase (e.g., Railway Postgres or standalone VPS). pg_dump target.
BACKUP_DATABASE_URL="postgresql://user:password@backup-host:5432/kanchuki_backup"
# F-016 Deletion Vault: Separate Postgres instance for soft-delete snapshots.
# The DB role behind this URL has INSERT-only grants — no UPDATE, no DELETE.
# Provision a new Railway Postgres, set the INSERT-only role, then set this.
VAULT_DATABASE_URL=""
# F-017: Migrator role credentials (human-only, NEVER in deployed .env).
# Used to run prisma migrate deploy.
# Postgres role: kanchuki_migrator (full DDL + DELETE privileges)
DATABASE_URL_MIGRATOR="postgresql://kanchuki_migrator:password@host:5432/postgres"
# F-017: Scoped purge-role URL for the 30-day purge cron. The cron cannot use
# DATABASE_URL (kanchuki_app has DELETE revoked) or DATABASE_URL_MIGRATOR
# (human-only). Postgres role: kanchuki_purge — DELETE on the purge tables only,
# no TRUNCATE/DROP/DDL. Read ONLY by apps/api/src/jobs/purge-soft-deleted.ts.
PURGE_DATABASE_URL="postgresql://kanchuki_purge:password@host:5432/postgres"
# Backup retention: number of daily backups to keep (default: 30)
BACKUP_RETENTION_DAYS="30"
# Backup schedule in cron format (default: daily at 2 AM)
BACKUP_SCHEDULE="0 2 * * *"
# R2 bucket name for backup storage (default: kanchuki-backups)
R2_BUCKET_NAME="kanchuki-backups"

# F-012: decrypts the integration_settings table (Admin → Integrations).
# Bootstrap secret — can never live in that table itself (it's what unlocks
# it), so it stays here permanently. Generate with: openssl rand -hex 32
# NEVER commit actual value.
ENCRYPTION_MASTER_KEY=""

# ─── Supabase Auth ──────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
# NEVER commit actual value — must be the service_role key, NOT the anon key
SUPABASE_SERVICE_KEY=""
# Settings > API > JWT Secret. Used to verify auth tokens locally (HS256)
# instead of round-tripping to Supabase's Auth API on every request.
SUPABASE_JWT_SECRET=""      # NEVER commit actual value

# ─── MSG91 OTP (real OTP configuration, 2026-08-12) ────────────────
# API-side keys — SAME values the Supabase send-sms-hook Edge Function uses
# (copy them into the API Railway env; also register them locally for dev).
# MSG91_AUTHKEY is used by BOTH the classic OTP send (POST /api/v5/otp) and
# the widget access-token re-verification (POST /api/v5/widget/verifyAccessToken).
# When these are unset, /v1/auth/otp/* falls back to the legacy Supabase path.
MSG91_AUTHKEY=""
# The OTP template id from the MSG91 dashboard (used by /v1/auth/otp/send).
MSG91_TEMPLATE_ID=""
# Shared secret for the MSG91 Events & Actions webhook receiver
# (POST /v1/public/webhooks/msg91/events). Set the same value as the
# x-msg91-webhook-secret header in the MSG91 dashboard's webhook config.
# Unset = webhook requests rejected (503).
MSG91_WEBHOOK_SECRET=""
# Build-time vars (inlined at build — set as build args on Railway):
#   - Mobile: EXPO_PUBLIC_MSG91_WIDGET_ID / _TOKEN_AUTH (apps/mobile/eas.json
#     or apps/mobile/.env)
#   - Web: NEXT_PUBLIC_MSG91_WIDGET_ID / _TOKEN_AUTH (apps/web/Dockerfile ARGs)
# These are MSG91 WIDGET credentials — client-visible by MSG91's design (they
# only authorize this widget, never the account authkey above).
EXPO_PUBLIC_MSG91_WIDGET_ID=""
EXPO_PUBLIC_MSG91_TOKEN_AUTH=""
NEXT_PUBLIC_MSG91_WIDGET_ID=""
NEXT_PUBLIC_MSG91_TOKEN_AUTH=""

# ─── OTP test bypass (pre-production ONLY, 2026-08-13) ──────────────
# When "1", phones that ALREADY EXIST as Supabase auth users skip the real
# MSG91 OTP send + verify entirely — /otp/send returns "OTP sent" without
# calling MSG91 and /otp/verify accepts ANY code, minting a session. This
# lets testers log in with their own numbers before the MSG91 sender's DLT
# registration lands (the API path currently returns "success" while the
# carrier silently drops the SMS). Whitelist = Supabase auth.users: pre-create
# a user with the tester's phone (E.164 +91... or bare 10 digits) in the
# Supabase dashboard.
# ⚠️ SECURITY: this is a FULL auth bypass for whitelisted phones. NEVER set
# it on a real deployment. Once MSG91's DLT registration is approved, unset
# it — the real OTP flow then applies to the very same numbers, no migration.
OTP_TEST_BYPASS=""

# ─── F-032 AI Studio Shoots (Phase A, 2026-08-13) ───────────────────
# FLUX Kontext via Black Forest Labs hosted API — subject-consistent
# studio background generation for product photos (templates only).
# Pay-per-image (~₹2–6/image). Used by the API service only.
# Get a key: https://api.bfl.ai (dashboard → API keys)
BFL_API_KEY=""

# ─── Redis (Upstash) ────────────────────────────────────────────
REDIS_URL="redis://default:password@host:port"

# ─── Cloudflare R2 ──────────────────────────────────────────────
# F-012: ACCESS_KEY_ID/SECRET_ACCESS_KEY/BUCKET_NAME are admin-manageable —
# Admin → Integrations overrides these once configured there (getSecret()
# checks the DB first, falls back here). ACCOUNT_ID/PUBLIC_URL stay env-only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""      # NEVER commit actual value
R2_BUCKET_NAME="kanchuki-dev"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ─── AI APIs ────────────────────────────────────────────────────
# F-012: admin-manageable — see note above.
ANTHROPIC_API_KEY=""  # NEVER commit actual value (for Claude Vision AI tagging)
OPENAI_API_KEY=""     # NEVER commit actual value (for embeddings + AI tagging failover)
# AI-tagging failover: if the primary provider (Claude) is out of credits /
# rate-limited / down, tagging and color detection automatically fall over to
# the next configured provider. Gemini needs NO SDK — plain REST.
GEMINI_API_KEY=""     # NEVER commit actual value (Google Gemini AI tagging failover)

# Multi-provider failover order (comma-separated ids: claude, openai, gemini).
# Only providers with a configured key are tried. A failing provider enters a
# cooldown (default 5 min) and is retried lazily after it expires; a success
# clears the mark immediately (self-heal).
AI_PROVIDER_ORDER="claude,openai,gemini"
AI_PROVIDER_COOLDOWN_MS="300000"

# F-023 AI Provider Registry — keys for the generic OpenAI-compatible adapter
# (Admin → AI Providers, provider_type OPENAI_COMPAT). One OpenRouter key
# unlocks hundreds of models (Claude, GPT, Gemini, Llama, DeepSeek, ...) behind
# a single credit balance. Each can also be set in Admin → Integrations instead
# of here; the registry's api_key_name must match the var name.
OPENROUTER_API_KEY=""   # any model via OpenRouter (https://openrouter.ai)
DEEPSEEK_API_KEY=""     # deepseek-chat / deepseek-reasoner (text-only — use a vision model for tagging)
MISTRAL_API_KEY=""      # Mistral vision models
GROQ_API_KEY=""         # Groq (fast inference)
TOGETHER_API_KEY=""     # Together AI
NVIDIA_API_KEY=""     # NVIDIA NIM: free Llama 3.2 11B/90B Vision fallbacks (https://build.nvidia.com)

# ─── Virtual Try-On ───────────────────────────────────────────────
# Fashion V-Tone v1.5 (Apache 2.0, maskless, CPU-capable)
# Deploy: services/fashion-vtone/Dockerfile
# ~$0.0003/try-on on CPU, ~$0.005 on GPU
# F-012: admin-manageable — see note above.
VTONE_API_URL="http://localhost:8001"

# ─── Photo-Cleanup Sidecar (torch/SAM2/rembg/LaMa, Hetzner CX43) ──
# Deploy: services/photo-cleanup/Dockerfile (compose: services/photo-cleanup/docker-compose.yml)
# Production: set PHOTO_CLEANUP_SERVICE_URL to the box + CLEANUP_SHARED_SECRET to
# the same value as the sidecar's CLEANUP_SHARED_SECRET. The heavy Python stack
# (peak ~2.2GB) NEVER runs in the 2GB Railway API container (measured 2026-08-08,
# scripts/demo/2026-08-08-sam2/memtest.py). When unset, the runner falls back to
# a local python exec (dev boxes only — the Railway Dockerfile installs no python).
# F-012: admin-manageable — see note above.
PHOTO_CLEANUP_SERVICE_URL=""
CLEANUP_SHARED_SECRET=""

# ─── F-031 Social Media Publishing (Meta Graph API) ─────────────────
# Phase 1: Facebook Page posts. Phase 2: WhatsApp Business native catalog sync.
# Meta for Developers app credentials — shared across all retailers (bring-your-own
# tokens stored per-retailer in SocialAccount / Retailer.whatsapp_api_* fields).
# F-012: admin-manageable — see note above.
META_APP_ID=""              # Meta for Developers App ID (public-ish)
META_APP_SECRET=""          # App Secret (server-side only) — NEVER commit actual value
# WhatsApp Business Account ID (WABA ID) — from Meta Business Manager → WhatsApp → Business Accounts
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Shared secret for Meta webhook verification (catalog events, etc.)
# Set the same value in Meta Developer Dashboard → Webhooks → Verify Token
META_WEBHOOK_SECRET=""

# ─── Payments (Razorpay) ────────────────────────────────────────
# Live keys — set real values in production
# F-012: KEY_ID/KEY_SECRET/WEBHOOK_SECRET are admin-manageable — see note above.
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"       # NEVER commit actual value
RAZORPAY_WEBHOOK_SECRET="xxx"   # NEVER commit actual value
# Razorpay plan IDs — create plans in Razorpay dashboard → Plans, then map here
# Needed for POST /billing/subscription to work
RAZORPAY_PLAN_STARTER_MONTHLY=""
RAZORPAY_PLAN_STARTER_ANNUAL=""
RAZORPAY_PLAN_GROWTH_MONTHLY=""
RAZORPAY_PLAN_GROWTH_ANNUAL=""
RAZORPAY_PLAN_PRO_MONTHLY=""
RAZORPAY_PLAN_PRO_ANNUAL=""

# ─── App Config ─────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
# Used internally by the API server (self-reference) and by the web app API routes
API_URL="http://localhost:3001"
# Base URL for generated collection share links (e.g. /c/{slug})
WEB_URL="http://localhost:3000"
# Admin panel authentication — set a strong random string to protect /v1/admin/*
ADMIN_API_KEY=""
# Admin CSRF cookie signing key — REQUIRED in production: index.ts throws at
# startup without it (a Date.now()-derived fallback would rotate cookies on
# every restart and silently kill admin sessions). Generate with:
#   npx tsx scripts/generate-production-secrets.ts
COOKIE_SECRET=""
# SECURITY §8: Admin login email (e.g. admin@kanchuki.com)
ADMIN_EMAIL=""
# SECURITY §8: Admin password hash in scrypt(salt:hash) format.
# Generate using: node scripts/generate-admin-hash.ts <password>
# NEVER use the legacy HMAC-SHA256 format — scrypt only.
ADMIN_PASSWORD_HASH=""
# SECURITY §8: TOTP secret for admin 2FA (base32-encoded).
# If set, admin login requires a 6-digit TOTP code from the authenticator app.
# Generate using: node scripts/generate-admin-hash.ts --totp
# Leave empty to skip TOTP (not recommended for production).
ADMIN_TOTP_SECRET=""

# Internal team (marketing/support staff) session tokens — /v1/team/*
# Set a strong random string. Distinct from JWT_SECRET/ADMIN_API_KEY above.
TEAM_JWT_SECRET=""
# TEAM_JWT_SECRET, COOKIE_SECRET, REVALIDATION_SECRET, ADMIN_API_KEY,
# ENCRYPTION_MASTER_KEY and RAZORPAY_WEBHOOK_SECRET can all be generated in
# one shot with: npx tsx scripts/generate-production-secrets.ts

# On-demand ISR revalidation — shared secret between API and Web for cache purge
# Must match REVALIDATION_SECRET set in the Web app's Railway environment
# Used by PATCH /v1/products/:id/status to instantly update collection link pages
REVALIDATION_SECRET=""

# ─── Measurement Extraction (Python CV) ─────────────────────────
# Path to measurement_extractor.py script (default: scripts/measurement_extractor.py)
MEASUREMENT_SCRIPT_PATH=""
# Python binary to use (default: python3 on Unix, python on Windows)
PYTHON_BIN=""

# ─── Monitoring (Optional in dev) ───────────────────────────────
SENTRY_DSN=""
AXIOM_TOKEN=""
AXIOM_DATASET="kanchuki-logs"
