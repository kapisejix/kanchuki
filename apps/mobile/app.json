{
  "expo": {
    "name": "Kanchuki",
    "slug": "kanchuki",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "kanchuki",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.kanchuki.retailer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.kanchuki.retailer",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your products to add them to your catalog with AI assistance.",
        "NSPhotoLibraryUsageDescription": "Select product photos from your gallery to add to your catalog."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#d2e2ec"
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select product photos for your catalog."
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "organization": "kanchuki",
          "project": "kanchuki-retailer",
          "dryRun": false
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "//": "App-to-app Facebook Page connect (no web OAuth, no OTP). appID + clientToken come from the Meta App Dashboard (Settings → Basic for the ID, Settings → Advanced → Client token). scheme MUST be fb<appID>. Requires an EAS/dev build — the SDK is a native module (not in Expo Go). See docs/social-connect-native.md.",
          "appID": "REPLACE_WITH_FACEBOOK_APP_ID",
          "clientToken": "REPLACE_WITH_FACEBOOK_CLIENT_TOKEN",
          "displayName": "Kanchuki",
          "scheme": "fbREPLACE_WITH_FACEBOOK_APP_ID",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecad74e1-8f22-4c83-9043-a9fbd33e62a9"
      }
    },
    "owner": "s.numbhraal"
  }
}
