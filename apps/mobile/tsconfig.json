{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@kanchuki/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@kanchuki/shared/*": [
        "../../packages/shared/src/*"
      ],
      // @msg91comm/sendotp-react-native ships raw TS source that fails strict
      // typecheck — see src/types/msg91-sendotp.d.ts for why this shadows it.
      "@msg91comm/sendotp-react-native": [
        "./src/types/msg91-sendotp.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}