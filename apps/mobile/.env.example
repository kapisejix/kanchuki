# Copy to apps/mobile/.env for local dev (already gitignored).
# EXPO_PUBLIC_* vars are inlined at build/start time — see eas.json for the
# EAS build equivalents (the real widget credentials live there).

# API base URL for local dev (EAS builds set the production URL).
EXPO_PUBLIC_API_URL=http://localhost:3001

# MSG91 OTP widget (real OTP flow, 2026-08-12).
# Client-visible by MSG91's design — they only authorize this widget, NOT the
# MSG91 account authkey (which stays server-side in the API env).
# When unset, the app falls back to the legacy API OTP flow (works in Expo Go).
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=
