{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPKGS",
    "watchPatterns": [
      "services/social-template/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}