      },

      // ══════════════════════════════════════════════════════════════
      // SECTION 6: MATURE MODELS (Ages 35 – 44 Years)
      // ══════════════════════════════════════════════════════════════
      {
        id: "model_female_nandini_35",
        code: "MODEL_FEMALE_MATURE_35",
        type: "model",
