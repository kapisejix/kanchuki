        prompt: "Fit this garment onto an 11-year-old Indian boy model named Vivaan standing confidently with natural posture. Exact garment color, fabric drape, and sharp embroidery detail."
      },

      // ══════════════════════════════════════════════════════════════
      // SECTION 3: TEENAGE MODELS (Ages 13 – 19)
      // ══════════════════════════════════════════════════════════════
      {
        id: "model_teen_girl_ananya",
        code: "MODEL_TEEN_GIRL_01",
        type: "model",
        categoryTag: "teen",
        title: "Rhea (Teenage Girl)",
        subtitle: "Age 16–18 Years · Contemporary Indian Teen · Trendy & Vibrant",
        gender: "Female",
        ageGroup: "Teen (16-18 Yrs)",
        imageUrl: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop&q=80",
        badge: "Teen Girls",
        badgeColor: "badge-purple",
        garmentFit: "Crop Top Lehengas, Fusion Kurti Sets, Saree Gowns, Co-ords",
        description: "Youthful Indian teenage model with fresh glowing skin, modern styling, and effortless Gen-Z poise for fusion wear.",
        prompt: "Fit this outfit onto a stylish 17-year-old Indian teenage girl model named Rhea with natural modern makeup and sleek hair. Flowing realistic fabric drape with 100% color-true lighting."
      },
      {
        id: "model_teen_boy_rohan",
