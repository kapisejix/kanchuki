<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanchuki AI Studio — Scene & Model Catalog Preview</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-marcellus { font-family: 'Marcellus', serif; }
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
    }
    .badge-fuchsia {
      background: #FDF2F8;
      color: #BE185D;
      border: 1px solid #FBCFE8;
    }
    .badge-purple {
      background: #F5F3FF;
      color: #6D28D9;
      border: 1px solid #DDD6FE;
    }
    .badge-amber {
      background: #FFFBEB;
      color: #B45309;
      border: 1px solid #FDE68A;
    }
    .badge-emerald {
      background: #ECFDF5;
      color: #047857;
      border: 1px solid #A7F3D0;
    }
    .badge-sky {
      background: #F0F9FF;
      color: #0369A1;
      border: 1px solid #BAE6FD;
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-[#F8F7FC] text-[#231F48] min-h-screen">

  <!-- ── Top Luxury Navigation ── -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-[#E0E1F6] px-6 py-4 shadow-sm">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#231F48] via-[#560A39] to-[#BB3F95] flex items-center justify-center text-white font-marcellus font-bold text-xl shadow-md">
          K
        </div>
        <div>
          <h1 class="text-xl font-extrabold text-[#231F48] font-marcellus tracking-wide">
            Kanchuki AI Studio
          </h1>
          <p class="text-xs text-[#6B4773] font-medium">
            Next-Gen Scenes & Indian Fashion Model Catalog (All Ages & Genders)
          </p>
        </div>
      </div>

      <!-- Quick Action Counter Stats -->
      <div class="flex items-center gap-2 text-xs font-semibold">
        <span class="px-3 py-1.5 rounded-xl bg-white border border-[#E0E1F6] text-[#231F48] shadow-xs">
          🏞️ <strong id="sceneCount">12</strong> Scenes
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white border border-[#E0E1F6] text-[#231F48] shadow-xs">
          💃 <strong id="modelCount">18</strong> Fashion Models
        </span>
        <button onclick="exportSelectedJson()" class="px-4 py-1.5 rounded-xl bg-[#231F48] text-white hover:bg-[#BB3F95] transition-colors flex items-center gap-1.5 shadow-sm">
          <i data-lucide="download" class="w-3.5 h-3.5"></i> Export Selected
        </button>
      </div>
    </div>
  </header>

  <!-- ── Filter & Search Control Bar ── -->
  <div class="max-w-7xl mx-auto px-6 pt-6 pb-2">
    <div class="bg-white rounded-3xl p-4 border border-[#E0E1F6] shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Tab Filters -->
      <div class="flex flex-wrap items-center gap-1.5 w-full md:w-auto">
        <button onclick="filterCategory('all')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-[#231F48] text-white" data-filter="all">
          All Previews (<span id="totalItems">30</span>)
        </button>
        <button onclick="filterCategory('scene')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200" data-filter="scene">
          🏞️ Scene Environments (12)
        </button>
        <button onclick="filterCategory('female')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200" data-filter="female">
          👗 Female Models (6)
        </button>
        <button onclick="filterCategory('male')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200" data-filter="male">
          👔 Male Models (4)
        </button>
        <button onclick="filterCategory('kids')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200" data-filter="kids">
          🧒 Kids & Toddlers (4)
        </button>
        <button onclick="filterCategory('teen')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200" data-filter="teen">
          🎒 Teenagers (2)
        </button>
        <button onclick="filterCategory('senior')" class="tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200" data-filter="senior">
          👑 35+ & 45+ Mature (4)
        </button>
      </div>

      <!-- Search Input -->
      <div class="relative w-full md:w-72">
        <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          id="searchInput"
          oninput="handleSearch()"
          placeholder="Search scene, model, age, style..."
          class="w-full pl-10 pr-4 py-2 bg-[#F8F7FC] rounded-2xl border border-[#E0E1F6] text-xs text-[#231F48] placeholder-gray-400 focus:outline-none focus:border-[#BB3F95]"
        />
      </div>
    </div>
  </div>

  <!-- ── Main Catalog Grid ── -->
  <main class="max-w-7xl mx-auto px-6 py-6">
    <div id="catalogGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <!-- Rendered dynamically by JS -->
    </div>
  </main>

  <!-- ── Detail Preview Modal ── -->
  <div id="detailModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 border border-[#E0E1F6] shadow-2xl relative">
      <button onclick="closeModal()" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-gray-200">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
      
      <div id="modalContent">
        <!-- Injected on click -->
      </div>
    </div>
  </div>

  <!-- ── Toast Notification ── -->
  <div id="toast" class="fixed bottom-6 right-6 bg-[#231F48] text-white px-5 py-3 rounded-2xl shadow-xl transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-2 z-50 text-xs font-semibold">
    <i data-lucide="check-circle" class="w-4 h-4 text-[#BB3F95]"></i>
    <span id="toastMsg">Code copied to clipboard!</span>
  </div>

  <script>
    // ── Dataset: Diverse AI Studio Scenes and Indian Models ──
    const ITEMS = [
      // ══════════════════════════════════════════════════════════════
      // SECTION 1: SCENE ENVIRONMENTS (Outdoor, Street, Beach, Nature)
      // ══════════════════════════════════════════════════════════════
      {
        id: "scene_botanical_garden",
        code: "SCENE_GARDEN_LUXURY",
        type: "scene",
        categoryTag: "scene",
        title: "Royal Botanical Garden",
        subtitle: "Lush Mughal garden with marble fountains & exotic florals",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=800&auto=format&fit=crop&q=80",
        badge: "Outdoor Nature",
        badgeColor: "badge-emerald",
        garmentFit: "Lehengas, Anarkalis, Kurta Sets, Kids Ethnic, Summer Florals",
        description: "Lush green heritage botanical garden setting with carved sandstone benches, gentle sunlight filtering through exotic palm canopies, and soft background marigold flowerbeds.",
        prompt: "Place this outfit naturally onto a model standing in a luxury botanical garden in India with lush manicured greenery, blooming lotus ponds, and soft golden-hour daylight bokeh in the background. Neutral 5500K daylight key light on the garment preserving 100% true fabric color, texture, and embroidery with realistic soft shadows."
      },
      {
        id: "scene_heritage_street",
        code: "SCENE_STREET_HAVELI",
        type: "scene",
        categoryTag: "scene",
        title: "Jaipur Heritage Street Wall",
        subtitle: "Pink terracotta walls with ornate Jharokha carved arches",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1477587458883-47145ed94245?w=800&auto=format&fit=crop&q=80",
        badge: "Urban Heritage",
        badgeColor: "badge-fuchsia",
        garmentFit: "Kurtis, Short Kurtas, Saree Drapes, Daily Ethnic, Fusion",
        description: "Iconic Jaipur old-city terracotta pink walls, intricate brass lanterns, and antique wooden doorways creating an authentic Rajasthani street editorial.",
        prompt: "Place this garment on a model in a vibrant Jaipur heritage street setting with authentic terracotta pink textured walls, antique carved wooden doors, and soft morning ambient sunlight. Garment details, zari work, exact dyes, and embroidery 100% faithful to the original with natural daylight soft shadows."
      },
      {
        id: "scene_mountain_resort",
        code: "SCENE_MOUNTAIN_VALLEY",
        type: "scene",
        categoryTag: "scene",
        title: "Himalayan Mountain Resort",
        subtitle: "Misty mountain pine valleys and cedar wood terrace deck",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&auto=format&fit=crop&q=80",
        badge: "Scenic Resort",
        badgeColor: "badge-sky",
        garmentFit: "Shawls, Velvet Suits, Winter Ethnic, Pashmina, Bandhgalas",
        description: "Panoramic Himalayan tea-estate resort deck with rolling mist over lush green hills and crisp clean mountain daylight.",
        prompt: "Place this outfit onto a model on a scenic mountain resort wooden deck in the Himalayas with misty pine-covered ridges and mountain horizons softly blurred in the background. Crisp daylight key lighting preserving the exact garment weave, rich fabric tone, and embroidery without amber tinting."
      },
      {
        id: "scene_beach_luxury",
        code: "SCENE_BEACH_COASTAL",
        type: "scene",
        categoryTag: "scene",
        title: "Goa Sunset Coastal Beach",
        subtitle: "Golden hour sands with soft turquoise ocean waves & coconut palms",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop&q=80",
        badge: "Coastal Sunset",
        badgeColor: "badge-amber",
        garmentFit: "Pastel Lehengas, Resort Wear, Indo-Western, Kurti Dresses",
        description: "Serene golden sands of a luxury private beach in Goa with glowing sunset reflections on calm water and swaying palm silhouettes.",
        prompt: "Place this garment on a model walking on a serene luxury beach at gentle sunset with golden sands and distant turquoise waves in background bokeh. Garment shape, exact dye color, lightweight georgette/chiffon drapes, and embroidery 100% color-true with soft natural grounding shadow."
      },
      {
        id: "scene_modern_art_wall",
        code: "SCENE_URBAN_ART_WALL",
        type: "scene",
        categoryTag: "scene",
        title: "Modern Contemporary Wall",
        subtitle: "Textured concrete & minimalist geometric architectural wall",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1513694203232-719a280e022f?w=800&auto=format&fit=crop&q=80",
        badge: "Minimalist Modern",
        badgeColor: "badge-purple",
        garmentFit: "Co-ords, Contemporary Kurtas, Western Fusion, Shirts",
        description: "Sleek architectural background with warm beige limewash texture and subtle modern bronze accents for high-fashion lookbooks.",
        prompt: "Place this outfit on a model in a contemporary architectural setting featuring neutral warm limewash textured concrete walls and soft natural window light. 100% preservation of fabric colors, patterns, stitch lines, and textures."
      },
      {
        id: "scene_palace_courtyard",
        code: "SCENE_ROYAL_PALACE",
        type: "scene",
        categoryTag: "scene",
        title: "Royal Palace Courtyard",
        subtitle: "Udaipur palace marble courtyard with royal arches & lanterns",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=800&auto=format&fit=crop&q=80",
        badge: "Royal Wedding",
        badgeColor: "badge-amber",
        garmentFit: "Bridal Lehengas, Royal Sherwanis, Heavy Silk Sarees",
        description: "Magnificent Rajasthani royal palace with white marble floors, hand-carved pillars, and candle-lit brass chandeliers in background bokeh.",
        prompt: "Place this ethnic outfit in a grand royal Indian palace courtyard with carved arches and gentle ambient evening light in the background bokeh. Neutral 5500K color-true key lighting to 100% preserve garment fabric color, heavy zari work, and hue."
      },
      {
        id: "scene_festive_diwali",
        code: "SCENE_FESTIVE_DIWALI",
        type: "scene",
        categoryTag: "scene",
        title: "Festive Diya Illumination",
        subtitle: "Warm festive backdrop with clay diyas & golden marigold torans",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1606293926075-69a00dbfde81?w=800&auto=format&fit=crop&q=80",
        badge: "Festival of Lights",
        badgeColor: "badge-amber",
        garmentFit: "Diwali Outfits, Silk Kurta Sets, Festive Sarees, Kids Ethnic",
        description: "Glowing Diwali night atmosphere with rows of illuminated clay diyas, rangoli motifs, and marigold garlands strictly in soft background focus.",
        prompt: "Place this ethnic garment in a festive Diwali celebration backdrop with subtle glowing diya light bokeh and marigold floral accents strictly in the background. Daylight-balanced key light on the garment preserving 100% original color and fabric details."
      },
      {
        id: "scene_catwalk_runway",
        code: "SCENE_CATWALK_RUNWAY",
        type: "scene",
        categoryTag: "scene",
        title: "Catwalk Fashion Runway",
        subtitle: "Lakme Fashion Week style glossy runway with overhead spotlights",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1509631179647-0177331693ae?w=800&auto=format&fit=crop&q=80",
        badge: "High Fashion",
        badgeColor: "badge-fuchsia",
        garmentFit: "Couture Lehengas, Designer Gowns, Men's Sherwanis, Runway",
        description: "Glossy black high-fashion runway with dramatic studio spotlights, soft spectator bokeh, and motion-drape styling.",
        prompt: "Place this outfit in a high-fashion catwalk runway show with overhead spotlights and soft blurred audience bokeh in the background. Graceful model walking with dramatic realistic draping, 100% color-true lighting."
      },
      {
        id: "scene_studio_editorial",
        code: "SCENE_STUDIO_EDITORIAL",
        type: "scene",
        categoryTag: "scene",
        title: "Vogue Studio Editorial",
        subtitle: "Seamless grey/beige studio with professional softbox lighting",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=800&auto=format&fit=crop&q=80",
        badge: "Magazine Cover",
        badgeColor: "badge-purple",
        garmentFit: "All Catalog Garments, Suits, Kurtis, Sarees, Menswear",
        description: "Neutral 5500K studio with soft directional shadows, subtle backdrop gradient, and crisp magazine-grade garment sharpness.",
        prompt: "Place this garment naturally onto a professional fashion model in a clean editorial studio. Color-true 5500K neutral studio softbox lighting with soft grounding shadows. No color shifts."
      },
      {
        id: "scene_macro_fabric",
        code: "SCENE_MACRO_FABRIC",
        type: "scene",
        categoryTag: "scene",
        title: "Macro Fabric Detail",
        subtitle: "Ultra-sharp close-up highlighting fine zari, weave & embroidery",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=800&auto=format&fit=crop&q=80",
        badge: "Craftsmanship",
        badgeColor: "badge-emerald",
        garmentFit: "Embroidery, Banarasi Weave, Zari Borders, Buttons, Prints",
        description: "Intimate close-up macro focal length highlighting the fine craftsmanship, needlework, thread count, and border motifs.",
        prompt: "An ultra-detailed macro close-up photograph highlighting the fine craftsmanship, texture, zari embroidery, and fabric weave of this garment. Sharp focus on intricate details with natural soft depth of field."
      },
      {
        id: "scene_terrace_cafe",
        code: "SCENE_TERRACE_CAFE",
        type: "scene",
        categoryTag: "scene",
        title: "Chic Rooftop Cafe",
        subtitle: "Boho aesthetic rooftop terrace with cane furniture & plants",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&auto=format&fit=crop&q=80",
        badge: "Casual Lifestyle",
        badgeColor: "badge-amber",
        garmentFit: "Short Kurtis, Co-ords, Casual Dresses, Tops, Casual Shirts",
        description: "Sunlit rooftop cafe with rattan chairs, terracotta planters, and soft aesthetic city skyline bokeh.",
        prompt: "Place this casual outfit on a model sitting in a chic sunlit rooftop cafe terrace with lush potted plants and warm daylight. Garment colors and cotton/linen textures 100% faithful to the original."
      },
      {
        id: "scene_white_studio",
        code: "SCENE_WHITE_MARKETPLACE",
        type: "scene",
        categoryTag: "scene",
        title: "Clean Marketplace White",
        subtitle: "Pure 100% seamless white backdrop for Myntra/Amazon listings",
        gender: "All Genders",
        ageGroup: "All Ages",
        imageUrl: "https://images.unsplash.com/photo-1558769132-cb1aea458c5e?w=800&auto=format&fit=crop&q=80",
        badge: "Marketplace Standard",
        badgeColor: "badge-sky",
        garmentFit: "All Catalog Garments, E-commerce Grid, Marketplace Ready",
        description: "Seamless white cyclorama studio wall with daylight-balanced CRI-98 studio softbox lighting and soft contact drop shadow.",
        prompt: "Replace background with a clean, seamless white studio backdrop. Neutral 5500K daylight-balanced CRI-98 studio lighting with soft grounding shadow under the garment. Keep product color 100% identical."
      },

      // ══════════════════════════════════════════════════════════════
      // SECTION 2: KIDS & TODDLER MODELS (Ages 3 – 12)
      // ══════════════════════════════════════════════════════════════
      {
        id: "model_kid_girl_aarohi",
        code: "MODEL_KID_GIRL_01",
        type: "model",
        categoryTag: "kids",
        title: "Aarohi (Kid Girl)",
        subtitle: "Age 4–6 Years · Indian Girl Model · Cute & Joyful",
        gender: "Female",
        ageGroup: "Kids (4-6 Yrs)",
        imageUrl: "https://images.unsplash.com/photo-1622290291468-a28f7a7dc6a8?w=800&auto=format&fit=crop&q=80",
        badge: "Kids Girls",
        badgeColor: "badge-fuchsia",
        garmentFit: "Kids Lehengas, Pattu Pavadai, Frocks, Festive Gowns, Anarkalis",
        description: "Adorable Indian girl model with sweet natural smile, gentle posture, and traditional hair accessories for kids ethnic wear.",
        prompt: "Fit this kids garment onto a cute 5-year-old Indian girl model named Aarohi with a joyful natural smile and neat braided hair. Draping proportioned perfectly for a child's silhouette with 100% color accuracy."
      },
      {
        id: "model_kid_boy_aarav",
        code: "MODEL_KID_BOY_01",
        type: "model",
        categoryTag: "kids",
        title: "Aarav (Kid Boy)",
        subtitle: "Age 5–7 Years · Indian Boy Model · Smart & Playful",
        gender: "Male",
        ageGroup: "Kids (5-7 Yrs)",
        imageUrl: "https://images.unsplash.com/photo-1595454223600-91fbdd7ee9a4?w=800&auto=format&fit=crop&q=80",
        badge: "Kids Boys",
        badgeColor: "badge-sky",
        garmentFit: "Kids Kurta-Pajama, Nehru Jackets, Dhoti Sets, Indo-Western",
        description: "Handsome young Indian boy with neat haircut and cheerful posture, ideal for boys wedding & festive ethnic wear.",
        prompt: "Fit this boys ethnic garment onto a smart 6-year-old Indian boy model named Aarav with a happy natural expression. Proportioned child fit with true-to-life fabric color and texture."
      },
      {
        id: "model_preteen_girl_diya",
        code: "MODEL_PRETEEN_GIRL_02",
        type: "model",
        categoryTag: "kids",
        title: "Diya (Pre-Teen Girl)",
        subtitle: "Age 9–11 Years · Indian Girl Model · Graceful & Confident",
        gender: "Female",
        ageGroup: "Pre-Teen (9-11 Yrs)",
        imageUrl: "https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=800&auto=format&fit=crop&q=80",
        badge: "Pre-Teen Girls",
        badgeColor: "badge-fuchsia",
        garmentFit: "Junior Lehengas, Crop-Top Skirts, Anarkali Suits, Gowns",
        description: "Graceful 10-year-old Indian girl with expressive eyes and confident posture for growing girls ethnic collections.",
        prompt: "Fit this garment onto a graceful 10-year-old Indian girl model named Diya with sleek hair and elegant natural posture. Accurate drape and 100% true garment color."
      },
      {
        id: "model_preteen_boy_kabir",
        code: "MODEL_PRETEEN_BOY_02",
        type: "model",
        categoryTag: "kids",
        title: "Vivaan (Pre-Teen Boy)",
        subtitle: "Age 10–12 Years · Indian Boy Model · Confident & Sharp",
        gender: "Male",
        ageGroup: "Pre-Teen (10-12 Yrs)",
