        prompt: "Fit this menswear garment onto a tall Indian male model named Kabir with athletic build and well-groomed beard. Flawless shoulder tailoring and 100% color-true lighting."
      },
      {
        id: "model_male_aditya_casual",
        code: "MODEL_MALE_CASUAL_KURTA",
