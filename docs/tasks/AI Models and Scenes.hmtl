        description: "Graceful Indian matriarch with kind smile, classic silver-streaked hair, and unmatched poise in traditional heavy silks.",
        prompt: "Fit this silk garment onto a graceful 50-year-old Indian elder woman named Sunita with silver-streaked hair and majestic posture. Flawless traditional saree pallu drape with 100% true zari sheen."
      },
      {
        id: "model_male_harish_45",
        code: "MODEL_MALE_SENIOR_45",
        type: "model",
        categoryTag: "senior",
        title: "Harish (Royal Patriarch 45+)",
        subtitle: "Age 50–60 Years · Royal Elder Gentleman · Silk Kurta & Shawl",
        gender: "Male",
        ageGroup: "Senior (45-60+ Yrs)",
        imageUrl: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=800&auto=format&fit=crop&q=80",
        badge: "Senior 45+",
        badgeColor: "badge-amber",
        garmentFit: "Pure Silk Kurtas, Kashmiri Pashmina Shawls, Achkans, Dhoti",
        description: "Dignified Indian elder patriarch with silver hair, warm expressive eyes, and royal heritage presence for senior ethnic wear.",
        prompt: "Fit this garment onto a dignified 55-year-old Indian elder gentleman named Harish with silver hair and refined posture. 100% preservation of embroidery, color, and fabric weight."
      }
    ];

    let currentFilter = 'all';
    let searchQuery = '';
    const selectedItemCodes = new Set();

    // ── Render Catalog Cards ──
    function renderCatalog() {
      const grid = document.getElementById('catalogGrid');
      const filtered = ITEMS.filter(item => {
        const matchesCat = currentFilter === 'all' || 
          (currentFilter === 'scene' && item.type === 'scene') ||
          (currentFilter === 'female' && item.type === 'model' && item.gender === 'Female' && !item.categoryTag.includes('kids') && !item.categoryTag.includes('teen') && !item.categoryTag.includes('senior')) ||
          (currentFilter === 'male' && item.type === 'model' && item.gender === 'Male' && !item.categoryTag.includes('kids') && !item.categoryTag.includes('teen') && !item.categoryTag.includes('senior')) ||
          (currentFilter === 'kids' && item.categoryTag === 'kids') ||
          (currentFilter === 'teen' && item.categoryTag === 'teen') ||
          (currentFilter === 'senior' && item.categoryTag === 'senior');

        const q = searchQuery.toLowerCase().trim();
        const matchesSearch = !q || 
          item.title.toLowerCase().includes(q) ||
          item.subtitle.toLowerCase().includes(q) ||
          item.code.toLowerCase().includes(q) ||
          item.garmentFit.toLowerCase().includes(q) ||
          item.ageGroup.toLowerCase().includes(q);

        return matchesCat && matchesSearch;
      });

      document.getElementById('totalItems').innerText = filtered.length;

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center">
            <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3 text-2xl">🔍</div>
            <h3 class="text-base font-bold text-gray-800">No scenes or models found</h3>
            <p class="text-xs text-gray-500 mt-1">Try adjusting your search query or category filters.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const isChecked = selectedItemCodes.has(item.code);
        return `
          <div class="glass-card rounded-[28px] overflow-hidden border border-[#E0E1F6] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <!-- Image Frame -->
            <div class="relative w-full aspect-[4/5] bg-gray-100 overflow-hidden cursor-pointer" onclick="openModal('${item.id}')">
              <img 
                src="${item.imageUrl}" 
                alt="${item.title}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/20 opacity-80 group-hover:opacity-90 transition-opacity"></div>
              
              <!-- Badges on Image -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${item.badgeColor} shadow-sm backdrop-blur-md">
                  ${item.badge}
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[9px] font-extrabold bg-black/60 text-white backdrop-blur-md">
                  ${item.type === 'scene' ? 'SCENE' : item.ageGroup}
                </span>
              </div>

              <div class="absolute bottom-3 left-3 right-3 text-white">
                <p class="text-sm font-extrabold font-marcellus leading-snug drop-shadow-sm">${item.title}</p>
                <p class="text-[11px] text-gray-200 truncate mt-0.5">${item.subtitle}</p>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-4 bg-white flex-1 flex flex-col justify-between gap-3">
              <div>
                <!-- Code Tag & Checkbox -->
                <div class="flex items-center justify-between gap-2 pb-2 border-b border-gray-100">
                  <span class="font-mono text-[11px] font-bold text-[#BB3F95] bg-fuchsia-50 px-2 py-0.5 rounded-md truncate max-w-[180px]">
                    ${item.code}
                  </span>
                  <label class="flex items-center gap-1.5 cursor-pointer text-[11px] font-bold text-[#231F48]" onclick="event.stopPropagation()">
                    <input 
                      type="checkbox" 
                      ${isChecked ? 'checked' : ''} 
                      onchange="toggleSelect('${item.code}')"
                      class="w-4 h-4 rounded text-[#BB3F95] focus:ring-[#BB3F95] rounded border-gray-300"
                    />
                    <span>Select</span>
                  </label>
                </div>

                <!-- Best For Garments -->
                <div class="mt-2.5">
                  <p class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Best Garments:</p>
                  <p class="text-xs text-[#231F48] font-medium leading-relaxed mt-0.5 line-clamp-2">
                    ${item.garmentFit}
                  </p>
                </div>
              </div>

              <!-- Quick Action Buttons -->
              <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
                <button 
                  onclick="copyToClipboard('${item.code}', 'Code ${item.code} copied!')"
                  class="flex-1 py-1.5 rounded-xl bg-gray-50 hover:bg-gray-100 border border-gray-200 text-[11px] font-bold text-[#231F48] flex items-center justify-center gap-1 transition-colors"
                >
                  <i data-lucide="copy" class="w-3 h-3 text-[#BB3F95]"></i> Code
                </button>
                <button 
                  onclick="copyToClipboard(\`${item.prompt.replace(/`/g, '\\`')}\`, 'Prompt formula copied!')"
                  class="flex-1 py-1.5 rounded-xl bg-fuchsia-50 hover:bg-fuchsia-100 border border-fuchsia-200 text-[11px] font-bold text-fuchsia-800 flex items-center justify-center gap-1 transition-colors"
                >
                  <i data-lucide="sparkles" class="w-3 h-3 text-fuchsia-600"></i> Prompt
                </button>
                <button 
                  onclick="openModal('${item.id}')"
                  class="w-8 h-8 rounded-xl bg-gray-50 hover:bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-600"
                  title="View Full Spec"
                >
                  <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      lucide.createIcons();
    }

    // ── Filter Category ──
    function filterCategory(cat) {
      currentFilter = cat;
      document.querySelectorAll('.tab-btn').forEach(btn => {
        if (btn.getAttribute('data-filter') === cat) {
          btn.className = "tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-[#231F48] text-white shadow-sm";
        } else {
          btn.className = "tab-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all bg-gray-100 text-gray-700 hover:bg-gray-200";
        }
      });
      renderCatalog();
    }

    // ── Search Handler ──
    function handleSearch() {
      searchQuery = document.getElementById('searchInput').value;
      renderCatalog();
    }

    // ── Selection Toggle ──
    function toggleSelect(code) {
      if (selectedItemCodes.has(code)) {
        selectedItemCodes.delete(code);
      } else {
        selectedItemCodes.add(code);
      }
      renderCatalog();
    }

    // ── Copy to Clipboard ──
    function copyToClipboard(text, msg = 'Copied to clipboard!') {
      navigator.clipboard.writeText(text).then(() => {
        showToast(msg);
      }).catch(() => {
        showToast('Error copying text');
      });
    }

    // ── Show Toast ──
    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    }

    // ── Open Detail Modal ──
    function openModal(id) {
      const item = ITEMS.find(i => i.id === id);
      if (!item) return;

      const modal = document.getElementById('detailModal');
      const content = document.getElementById('modalContent');

      content.innerHTML = `
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-32 h-44 rounded-2xl overflow-hidden bg-gray-100 flex-shrink-0 border border-gray-200 shadow-sm">
              <img src="${item.imageUrl}" alt="${item.title}" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${item.badgeColor}">
                  ${item.badge}
                </span>
                <span class="font-mono text-xs font-bold text-[#BB3F95] bg-fuchsia-50 px-2 py-0.5 rounded-md">
                  ${item.code}
                </span>
              </div>
              <h2 class="text-xl font-extrabold text-[#231F48] font-marcellus mt-1.5">${item.title}</h2>
              <p class="text-xs text-[#6B4773] mt-0.5">${item.subtitle}</p>
              
              <div class="grid grid-cols-2 gap-2 mt-3 pt-3 border-t border-gray-100 text-xs">
                <div>
                  <span class="text-gray-400 block text-[10px] font-bold uppercase">Gender:</span>
                  <span class="font-bold text-[#231F48]">${item.gender}</span>
                </div>
                <div>
                  <span class="text-gray-400 block text-[10px] font-bold uppercase">Age Group:</span>
                  <span class="font-bold text-[#231F48]">${item.ageGroup}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">
            <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Visual Concept & Atmosphere</h4>
            <p class="text-xs text-[#231F48] leading-relaxed">${item.description}</p>
          </div>

          <!-- Garment Suitability -->
          <div>
            <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Recommended Indian Garment Types</h4>
            <p class="text-xs font-bold text-[#BB3F95] bg-fuchsia-50 p-3 rounded-xl border border-fuchsia-100">
              ${item.garmentFit}
            </p>
          </div>

          <!-- AI Studio Shoot Prompt Formula -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider">AI Studio Prompt Formula</h4>
              <button 
                onclick="copyToClipboard(\`${item.prompt.replace(/`/g, '\\`')}\`, 'Prompt formula copied!')" 
                class="text-[11px] font-bold text-[#BB3F95] hover:underline flex items-center gap-1"
              >
                <i data-lucide="copy" class="w-3 h-3"></i> Copy Prompt
              </button>
            </div>
            <div class="bg-[#231F48] text-gray-100 p-3.5 rounded-2xl font-mono text-[11px] leading-relaxed border border-gray-800 select-all">
              ${item.prompt}
            </div>
          </div>

          <div class="pt-2 flex items-center gap-3">
            <button 
              onclick="copyToClipboard('${item.code}', 'Code ${item.code} copied!'); closeModal();" 
              class="flex-1 py-2.5 rounded-2xl bg-[#231F48] text-white text-xs font-bold hover:bg-[#BB3F95] transition-colors flex items-center justify-center gap-1.5"
            >
              <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy Selection Code
            </button>
            <button 
              onclick="closeModal()" 
              class="px-5 py-2.5 rounded-2xl bg-gray-100 text-gray-700 text-xs font-bold hover:bg-gray-200"
            >
              Close
            </button>
          </div>
        </div>
      `;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function closeModal() {
      const modal = document.getElementById('detailModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // ── Export Selected as JSON ──
    function exportSelectedJson() {
      const selected = ITEMS.filter(i => selectedItemCodes.has(i.code));
      if (selected.length === 0) {
        showToast('Please check the "Select" box on 1 or more items first!');
        return;
      }
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(selected, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", "selected_ai_scenes_and_models.json");
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      showToast(`Exported ${selected.length} selections!`);
    }

    // Initialize on load
    window.addEventListener('DOMContentLoaded', () => {
      renderCatalog();
    });
  </script>
</body>
</html>
