      },

      // ══════════════════════════════════════════════════════════════
      // SECTION 7: SENIOR & ELDER MODELS (Over 45 Years / 45–60+)
      // ══════════════════════════════════════════════════════════════
      {
        id: "model_female_sunita_45",
        code: "MODEL_FEMALE_SENIOR_45",
        type: "model",
        categoryTag: "senior",
        title: "Sunita (Graceful Matriarch 45+)",
        subtitle: "Age 48–55 Years · Graceful Elder Woman · Pure Silk & Banarasi",
        gender: "Female",
        ageGroup: "Senior (45-60+ Yrs)",
